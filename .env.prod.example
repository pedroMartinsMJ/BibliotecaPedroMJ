# =============================================================================
# Biblioteca Pedro Martins - Ambiente de PRODUÇÃO (prod)
# =============================================================================
# ⚠️  Preencha com valores REAIS antes de usar.
#     NÃO commite este arquivo com segredos reais.
# =============================================================================

# --- Banco de Dados PostgreSQL ---
DB_HOST=seu-host-de-producao
DB_PORT=5432
DB_NAME=biblioteca_prod
DB_USERNAME=seu_usuario_prod
DB_PASSWORD=sua_senha_prod
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Spring Datasource ---
SPRING_DATASOURCE_URL=${DB_URL}
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# --- Chave de Criptografia (AES) — OBRIGATÓRIA em produção ⚠️
# Gere com: openssl rand -base64 32
# Se perder esta chave, não conseguirá descriptografar nomes e e-mails.
APP_ENCRYPTION_KEY=SUA_CHAVE_AES_PRODUCAO_BASE64_32_BYTES

# --- JWT (assinatura de tokens) — chaves RSA estáveis para produção ⚠️
JWT_PRIVATE_KEY=classpath:app.key
JWT_PUBLIC_KEY=classpath:app.pub

# --- OAuth2 Google — credenciais REAIS do Google Cloud Console ⚠️
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_GOOGLE_PRODUCAO
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_GOOGLE_PRODUCAO

# --- MinIO (armazenamento de objetos) ---
MINIO_ENDPOINT=https://seu-minio-producao
MINIO_ACCESS_KEY=SEU_ACCESS_KEY_PRODUCAO
MINIO_SECRET_KEY=SEU_SECRET_KEY_PRODUCAO
MINIO_BUCKET_NAME=livros-producao

# --- Configuração da Aplicação ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Frontend Angular ---
FRONTEND_URL=https://seu-frontend-producao

# --- Seed de dados de demonstração — DESATIVADO em produção ---
APP_SEED_DEMO=false