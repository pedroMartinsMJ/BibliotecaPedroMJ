# --- Banco de Dados PostgreSQL (container Docker biblioteca-postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca_prod
DB_USERNAME=pedro
DB_PASSWORD=senha123
DB_URL=jdbc:postgresql://localhost:5432/biblioteca_prod

# --- Spring Datasource ---
SPRING_DATASOURCE_URL=${DB_URL}
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# --- Chave de Criptografia (AES) — fictícia, só para teste ---
APP_ENCRYPTION_KEY=ZmlydGUtc2ltdWxhY2FvLXNlbWUtY2hhdmVzLXJlYWw=

# --- JWT (assinatura de tokens) — chaves fictícias para teste ---
JWT_PRIVATE_KEY=classpath:app.key
JWT_PUBLIC_KEY=classpath:app.pub

# --- OAuth2 Google — credenciais de TESTE (não funcionam de verdade) ---
# O start-menu (opção 2) sobrescreve apenas estas duas chaves quando existe um
# .env real na raiz: client do Google não dá para simular. Todo o resto do
# ambiente continua vindo deste arquivo.
GOOGLE_CLIENT_ID=google-teste-simulacao-12345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-teste-simulacao-secreto-ficticio-nao-real

# --- MinIO (armazenamento de objetos) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=livros-simulacao

# --- Configuração da Aplicação ---
SPRING_PROFILES_ACTIVE=prodsim
SERVER_PORT=8080

# --- Frontend Angular ---
FRONTEND_URL=http://localhost:4200

# --- Seed de dados de demonstração (fictícios) ---
APP_SEED_DEMO=true