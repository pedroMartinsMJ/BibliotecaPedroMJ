# =============================================================================
# Biblioteca Pedro Martins - Exemplo de Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com senhas ou chaves reais.
# =============================================================================

# --- Banco de Dados PostgreSQL ---
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
DB_URL=jdbc:postgresql://localhost:5432/biblioteca_db

# --- Spring Datasource ---
SPRING_DATASOURCE_URL=${DB_URL}
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# --- Chave de Criptografia (AES) para dados sensíveis ---
# Gere uma chave segura: openssl rand -base64 32
APP_ENCRYPTION_KEY=SUA_CHAVE_AES_AQUI_BASE64_32_BYTES

# --- JWT (assinatura de tokens) ---
JWT_PRIVATE_KEY=classpath:app.key
JWT_PUBLIC_KEY=classpath:app.pub

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_GOOGLE

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=livros

# --- Aplicação ---
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080

# --- Frontend Angular ---
FRONTEND_URL=http://localhost:4200